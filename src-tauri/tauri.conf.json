{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CostTracer",
  "version": "0.5.0",
  "identifier": "com.costtracer.app",
  "build": {
    "frontendDist": "../dist/cost-tracer/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CostTracer",
        "width": 560,
        "height": 760,
        "minWidth": 460,
        "minHeight": 560,
        "resizable": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
